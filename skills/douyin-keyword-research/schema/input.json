{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["seed"],
  "properties": {
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "description": "抖音种子词，如「渔具」"
    },
    "include_video": {
      "type": "boolean",
      "default": true
    },
    "include_product": {
      "type": "boolean",
      "default": true
    },
    "date_range_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "default": 30
    },
    "model_id": {
      "type": ["string", "null"],
      "description": "可选会话模型钉扎"
    }
  },
  "additionalProperties": true
}
