# LLM — NewAPI OpenAI-compatible；路由见 AGENTS.md「模型路由」
OPENAI_API_BASE=https://api.hyhacct.com/v1
# heavy（复杂运营分析 / 方案撰写）；OPENAI_API_KEY / LLM_MODEL 为兼容别名
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.6-luna
LLM_HEAVY_API_KEY=
LLM_HEAVY_MODEL=gpt-5.6-luna
# light（摘要 / 事实提取 / 意图分类 / 记忆压缩 / 简单格式化）
LLM_LIGHT_API_KEY=sk-...
LLM_LIGHT_MODEL=agnes-2.0-flash

# LangSmith (optional, production observability)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=agent-platform

# Checkpoint DB (production: use Postgres)
# CHECKPOINT_DB_URL=postgresql://user:pass@localhost:5432/agent_platform

# MCP servers config path
MCP_CONFIG_PATH=config/mcp.json
AGENT_ENV=dev
MCP_RUNTIME_ENABLED=true
# Leave unset to derive from AGENT_ENV (dev=true, staging/prod=false)
# MCP_ALLOW_STUB_FALLBACK=true
# MCP_WRITE_TOKEN=
# DOUYIN_CHROME_USER_DATA_DIR=

# Platform MCP gateway runs on deploy host (not laptop). Client URL:
# MCP_GATEWAY_URL=https://www.yoto.work/platform-mcp/mcp
# (config/mcp.json platform_mcp.url should match)
#
# Excel uploads MUST share the gateway-readable absolute path (API + MCP 同机):
# UPLOAD_ROOT=/data/platform-mcp/uploads
# Prod API: https://www.yoto.work/agent-platform/api/docs

# Commander Temu Job（API 工具状态探测 + MCP 网关共用）
COMMANDER_API_BASE=https://www.yoto.work/api/v1
COMMANDER_ACCESS_TOKEN=
COMMANDER_DEFAULT_AGENT_ID=肉机
COMMANDER_DEFAULT_PLATFORM=temu
# COMMANDER_SHOP_MAP={"徐铨金牌店":"8381218"}

# Vector store (optional)
# CHROMA_PERSIST_DIR=knowledge/index/chroma
